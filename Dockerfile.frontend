# syntax=docker/dockerfile:1
FROM python:3.15-slim

ENV PYTHONUNBUFFERED=1 PORT=8082 API_URL=http://api:8000/generate

LABEL org.opencontainers.image.source="https://github.com/Joelrtharakan/flowchartgenerator" \
      org.opencontainers.image.description="Flowchart generator frontend proxy"

RUN useradd --create-home --uid 10001 appuser
WORKDIR /app
COPY frontend/ ./frontend/
COPY frontend-logs/ ./frontend/logs/
RUN chown -R appuser:appuser /app
USER appuser

EXPOSE 8082
HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
  CMD python -c "import urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:8082/health', timeout=4).status == 200 else 1)"

CMD ["python", "frontend/server.py"]
