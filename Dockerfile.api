# syntax=docker/dockerfile:1

# ---- Stage 1: build wheels (keeps compilers/caches out of the final image) ----
FROM python:3.12-slim AS builder
# requirements-api.txt = full ML stack (default); requirements-lite.txt = no model, for demos
ARG REQUIREMENTS=requirements-api.txt
WORKDIR /build
COPY training/requirements-*.txt ./
RUN pip install --no-cache-dir --upgrade pip \
 && pip wheel --no-cache-dir --wheel-dir /wheels -r ${REQUIREMENTS}

# ---- Stage 2: slim runtime ----
FROM python:3.12-slim AS runtime

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    LOG_DIR=/app/logs \
    CURRENT_MODEL_FILE=/app/current_model.txt \
    HF_HOME=/app/.cache/huggingface

LABEL org.opencontainers.image.source="https://github.com/Joelrtharakan/flowchartgenerator" \
      org.opencontainers.image.description="Flowchart generator inference API"

RUN useradd --create-home --uid 10001 appuser
WORKDIR /app

COPY --from=builder /wheels /wheels
RUN pip install --no-cache-dir --no-index --find-links=/wheels /wheels/* && rm -rf /wheels

COPY training/app.py .
# LoRA adapters are mounted at /app/models (volume / PVC) - they are not baked in
RUN mkdir -p /app/logs /app/models /app/.cache && chown -R appuser:appuser /app
USER appuser

EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=5s --start-period=120s --retries=3 \
  CMD python -c "import urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:8000/health', timeout=4).status == 200 else 1)"

CMD ["uvicorn", "app:app", "--host", "0.0.0.0", "--port", "8000"]
